# HANVA Technologies — Environment Configuration Example
# Copy to .env.local for local overrides. Never commit secrets to version control.

# Node.js runtime environment (production / development / test)
NODE_ENV=production

# Server listener port (default: 3000)
PORT=3000

# Canonical public site URL (hardcoded default in metadata: https://www.hanva.in)
NEXT_PUBLIC_SITE_URL=https://www.hanva.in

# Optional Analytics Configuration (leave blank until owner creates GA4/GTM property; prefer GTM if both exist)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Phase 23 Website-to-CRM Integration Mode:
#   disabled            -> Fail-closed 503 with WhatsApp/Email/Phone fallback (use on live web host until Stage A passes)
#   sandbox_mock        -> Non-production validation, dedupe & classification sandbox (production_crm_synced=false)
#   live_signed_gateway -> Server-to-server HMAC gateway (REQUIRES CRM_STAGE_A_SECURITY_APPROVED=true & signing keys)
CRM_INTEGRATION_MODE=sandbox_mock

# Explicit Stage A security clearance gate (MUST stay false until CRM critical blockers are remediated & signed off)
CRM_STAGE_A_SECURITY_APPROVED=false

# Server-to-server signed CRM ingestion endpoint & secrets (NEVER prefix with NEXT_PUBLIC_)
# CRM_WEBSITE_INGEST_URL=https://crm.hanva.in/api/v1/ingest/website-leads
# CRM_WEBSITE_INGEST_TOKEN=
# CRM_WEBSITE_HMAC_SECRET=

# Rate-limiting & logging overrides (server-only)
# LEAD_RATE_LIMIT_MAX=25
# LEAD_RATE_LIMIT_WINDOW_MS=60000
