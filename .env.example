# HANVA Technologies — Environment Configuration Example
# Copy to .env.local for local overrides. Never commit secrets to version control.

# Node.js runtime environment (production / development / test)
NODE_ENV=production

# Server listener port (default: 3000)
PORT=3000

# Canonical public site URL (hardcoded default in metadata: https://hanva.in)
NEXT_PUBLIC_SITE_URL=https://hanva.in

# Future CRM Webhook endpoint for live lead delivery (optional - currently running in transparent preview mode)
# CONTACT_FORM_WEBHOOK_URL=https://api.hanva.in/v1/leads
