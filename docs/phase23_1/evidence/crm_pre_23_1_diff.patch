+// Export converted IVR leads for CSV download (tenant-wide or campaign-scoped)
+export async function getIvrConvertedLeadsForExport(params: {
+    tenantId?: string
+    uploadRequestId?: string
+    limit?: number
+}) {
+    try {
+        let tId = params.tenantId
+        if (!tId) {
+            const supabase = await createClient()
+            const { data: { user } } = await supabase.auth.getUser()
+            if (!user) throw new Error("Unauthorized")
+            const { data: profile } = await supabase.from('users').select('tenant_id').eq('id', user.id).single()
+            tId = profile?.tenant_id
+        }
+        if (!tId) throw new Error("Tenant ID required")
+
+        const supabaseAdmin = getSupabaseAdmin()
+
+        // Map users in tenant for telecaller names
+        const { data: users } = await supabaseAdmin
+            .from('users')
+            .select('id, full_name, email')
+            .eq('tenant_id', tId)
+
+        const userMap: Record<string, string> = {}
+        ;(users || []).forEach((u: any) => {
+            userMap[u.id] = u.full_name || u.email || 'Telecaller'
+        })
+
+        let campaignName = ''
+        let query = supabaseAdmin
+            .from('leads')
+            .select('id, name, phone, status, priority, assigned_to, notes, created_at')
+            .eq('tenant_id', tId)
+            .or('name.ilike.%IVR%,notes.ilike.%IVR%')
+            .order('created_at', { ascending: false })
+            .limit(params.limit || 10000)
+
+        if (params.uploadRequestId) {
+            const { data: currentReq } = await supabaseAdmin
+                .from('ivr_upload_requests')
+                .select('id, created_at, did_number, campaign_name')
+                .eq('id', params.uploadRequestId)
+                .single()
+
+            if (currentReq) {
+                campaignName = currentReq.campaign_name || ''
+                // Find next newer request in the same tenant to bound the campaign window
+                const { data: newerReqs } = await supabaseAdmin
+                    .from('ivr_upload_requests')
+                    .select('id, created_at')
+                    .eq('tenant_id', tId)
+                    .gt('created_at', currentReq.created_at)
+                    .order('created_at', { ascending: true })
+                    .limit(1)
+
+                query = query.gte('created_at', currentReq.created_at)
+                if (newerReqs && newerReqs.length > 0) {
+                    query = query.lt('created_at', newerReqs[0].created_at)
+                }
+            }
+        }
+
+        const { data: leads, error } = await query
+        if (error) throw new Error(error.message)
+
+        const records = (leads || []).map((l: any) => {
+            // Extract DTMF digit pressed if present
+            const digitMatch = l.notes?.match(/pressed digit "?([0-9#*])"?/i) || l.notes?.match(/digit\s*[:=]\s*([0-9#*])/i) || l.notes?.match(/\(Digit: "([^"]+)"\)/i)
+            const dtmfDigit = digitMatch ? digitMatch[1] : ''
+
+            // Extract campaign if present in note
+            const campMatch = l.notes?.match(/Campaign:\s*([^\s.]+)/i)
+            const extractedCamp = campMatch ? campMatch[1] : campaignName
+
+            let createdIST = ''
+            try {
+                createdIST = new Date(l.created_at).toLocaleString('en-IN', {
+                    timeZone: 'Asia/Kolkata',
+                    day: '2-digit',
+                    month: 'short',
+                    year: 'numeric',
+                    hour: '2-digit',
+                    minute: '2-digit',
+                    second: '2-digit',
+                    hour12: true
+                })
+            } catch {
+                createdIST = l.created_at || ''
+            }
+
+            return {
+                id: l.id,
+                name: l.name || '',
+                phone: l.phone || '',
+                status: l.status || 'new',
+                priority: l.priority || 'medium',
+                assigned_to: l.assigned_to ? (userMap[l.assigned_to] || 'Assigned') : 'Unassigned',
+                dtmf_digit: dtmfDigit,
+                campaign: extractedCamp,
+                created_at_ist: createdIST,
+                notes: (l.notes || '').replace(/[\r\n]+/g, ' -- ')
+            }
+        })
+
+        return { success: true, count: records.length, records, campaignName }
+    } catch (e: any) {
+        console.error("Export Converted Leads Error:", e)
+        return { success: false, error: e.message, records: [] }
+    }
+}
