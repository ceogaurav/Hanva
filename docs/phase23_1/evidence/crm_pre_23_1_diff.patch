+/**
+ * Direct IVR Campaign Data Upload with Auto-Splitting and Safe Stop -> Upload -> Start Lifecycle.
+ * Contacts are delivered via CloudAgent's batch multipart endpoint to Ozonetel's ETL processor,
+ * tracking real-time status in Ozonetel's Upload Status table.
+ */
+export async function submitDirectIvrCampaignUpload(data: {
+    campaignName: string
+    didNumber?: string
+    didLabel?: string
+    phoneNumbers: string[]
+    preferredSchedule?: string
+    velocity?: string
+    notes?: string
+    selectedCampaignNames?: string[]
+    ivrFlow?: 'ICICI' | 'HDFC' | 'AXIS' | 'KOTAK' | 'INDUSIND'
+}) {
+    try {
+        const supabase = await createClient()
+        const { data: { user } } = await supabase.auth.getUser()
+        if (!user) throw new Error("Unauthorized")
+
+        const { data: profile } = await supabase.from('users').select('tenant_id, full_name').eq('id', user.id).single()
+        if (!profile) throw new Error("Profile not found")
+
+        const { data: org } = await supabase.from('organizations').select('name').eq('id', profile.tenant_id).single()
+        const supabaseAdmin = getSupabaseAdmin()
+
+        // 1. Clean & validate 10-digit Indian numbers
+        const cleanNumbers: string[] = []
+        for (const p of data.phoneNumbers || []) {
+            const digits = String(p || '').replace(/\D/g, '').slice(-10)
+            if (digits.length === 10 && /^[6-9]\d{9}$/.test(digits)) {
+                cleanNumbers.push(digits)
+            }
+        }
+        const uniqueNumbers = Array.from(new Set(cleanNumbers))
+        if (uniqueNumbers.length === 0) {
+            throw new Error("No valid 10-digit phone numbers found to upload")
+        }
+
+        // 2. Wallet balance check (deferred per user instructions - deduction rules will be specified later)
+        // const { data: wallet } = await supabaseAdmin
+        //     .from('tenant_wallets')
+        //     .select('credits_balance')
+        //     .eq('tenant_id', profile.tenant_id)
+        //     .maybeSingle()
+        // const currentBalance = wallet?.credits_balance ?? 0
+        // if (currentBalance < uniqueNumbers.length) {
+        //     throw new Error(`Insufficient IVR credits. You have ${currentBalance.toLocaleString()} credits, but this upload requires ${uniqueNumbers.length.toLocaleString()} credits. Please recharge your wallet.`)
+        // }
+
+        // 3. Find tenant's allotted Ozonetel campaigns
+        const campRes = await getTenantOzonetelCampaigns(profile.tenant_id, data.didNumber ? [data.didNumber] : [])
+        let allCamps = campRes.campaigns || []
+
+        let targetCampaigns: any[] = []
+        if (data.selectedCampaignNames && data.selectedCampaignNames.length > 0) {
+            targetCampaigns = allCamps.filter(c => data.selectedCampaignNames!.includes(c.campaignName))
+        } else {
+            // Default: pick RUNNING, READY, or COMPLETED campaigns; if none, all tenant campaigns
+            targetCampaigns = allCamps.filter(c => c.position === 'RUNNING' || c.position === 'READY' || c.position === 'COMPLETED')
+            if (targetCampaigns.length === 0 && allCamps.length > 0) {
+                targetCampaigns = allCamps
+            }
+        }
+
+        if (targetCampaigns.length === 0) {
+            throw new Error("No active outbound IVR campaigns found for this tenant. Please contact support or ensure your campaign lines are provisioned.")
+        }
+
+        // 4. Split numbers evenly across target campaigns
+        const K = targetCampaigns.length
+        const baseCount = Math.floor(uniqueNumbers.length / K)
+        let remainder = uniqueNumbers.length % K
+
+        const campaignAllocations: Array<{
+            campaignId: number
+            campaignName: string
+            displayLabel: string
+            allocatedCount: number
+            uploadedCount: number
+            numbers: string[]
+            wasRunning: boolean
+            status: string
+            transactionId?: string
+            error?: string
+        }> = []
+
+        let startIndex = 0
+        for (let i = 0; i < K; i++) {
+            const count = baseCount + (remainder > 0 ? 1 : 0)
+            if (remainder > 0) remainder--
+
+            const slice = uniqueNumbers.slice(startIndex, startIndex + count)
+            startIndex += count
+
+            campaignAllocations.push({
+                campaignId: Number(targetCampaigns[i].campaignId),
+                campaignName: targetCampaigns[i].campaignName,
+                displayLabel: targetCampaigns[i].displayLabel,
+                allocatedCount: slice.length,
+                uploadedCount: 0,
+                numbers: slice,
+                wasRunning: false,
+                status: 'pending'
+            })
+        }
+
+        // 5. Execute Safe Lifecycle: Flow Sync -> Stop -> Batch Upload -> Wait for Ozonetel ETL Completion -> Start
+
+        // 5a. Ensure selected IVR Flow (ICICI, HDFC, AXIS, KOTAK, or INDUSIND) is applied to all target campaigns
+        if (data.ivrFlow && ['ICICI', 'HDFC', 'AXIS', 'KOTAK', 'INDUSIND'].includes(data.ivrFlow)) {
+            for (const alloc of campaignAllocations) {
+                try {
+                    await setCampaignIvrFlow(alloc.campaignId, data.ivrFlow as any)
+                } catch (flowErr) {
+                    console.warn(`Error applying ${data.ivrFlow} flow to ${alloc.campaignName}:`, flowErr)
+                }
+            }
+        }
+
+        // 5b. Stop any currently RUNNING target campaigns before uploading
+        for (const alloc of campaignAllocations) {
+            if (alloc.numbers.length === 0) continue
+            try {
+                const target = targetCampaigns.find(t => t.campaignName === alloc.campaignName)
+                const isRunning = target?.position === 'RUNNING'
+                alloc.wasRunning = isRunning
+                if (isRunning) {
+                    await toggleOzonetelCampaignStatus(alloc.campaignName, 'Stop', alloc.campaignId)
+                    await new Promise(r => setTimeout(r, 600))
+                }
+            } catch (err) {
+                console.warn(`Error stopping ${alloc.campaignName} before upload:`, err)
+            }
+        }
+
+        // 5b. Upload batches to each campaign via CloudAgent multipart endpoint directly to ETL background processor
+        const pendingTxIds: string[] = []
+        for (const alloc of campaignAllocations) {
+            if (alloc.numbers.length === 0) continue
+
+            try {
+                let cId = alloc.campaignId
+                if (!cId) {
+                    const match = allCamps.find(c => c.campaignName === alloc.campaignName)
+                    cId = Number(match?.campaignId)
+                    alloc.campaignId = cId
+                }
+
+                if (!cId) {
+                    throw new Error(`Numeric campaignId missing for ${alloc.campaignName}`)
+                }
+
+                const upRes = await uploadContactsToCloudAgentCampaign(cId, alloc.numbers)
+                alloc.uploadedCount = alloc.numbers.length
+                alloc.transactionId = upRes.transactionId
+                alloc.status = upRes.success ? 'uploaded' : 'failed'
+                if (upRes.transactionId) {
+                    pendingTxIds.push(upRes.transactionId)
+                }
+            } catch (err: any) {
+                console.error(`Error uploading to ${alloc.campaignName}:`, err)
+                alloc.status = 'error'
+                alloc.error = err.message
+            }
+        }
+
+        // 5c. Wait for Ozonetel's asynchronous ETL background job to complete ingestion!
+        // Ozonetel automatically sets campaign position to 'READY' upon ETL completion.
+        // Waiting ensures our 'Start' command fires AFTER the ETL finishes, so campaigns stay 'RUNNING'.
+        if (pendingTxIds.length > 0) {
+            console.log(`Waiting for Ozonetel ETL completion on ${pendingTxIds.length} transactions:`, pendingTxIds)
+            await waitForUploadTransactions(pendingTxIds, 25000)
+        } else {
+            await new Promise(r => setTimeout(r, 3000))
+        }
+
+        // 5d. Start all allocated campaigns that received numbers
+        for (const alloc of campaignAllocations) {
+            if (alloc.uploadedCount > 0) {
+                try {
+                    await toggleOzonetelCampaignStatus(alloc.campaignName, 'Start', alloc.campaignId)
+                    await new Promise(r => setTimeout(r, 800))
+                } catch (startErr) {
+                    console.error(`Failed to start ${alloc.campaignName} after ETL:`, startErr)
+                }
+            }
+        }
+
+        // 6. Credit deduction deferred (user will specify deduction rules later)
+        // const { error: ledgerError } = await supabaseAdmin.from('wallet_ledger').insert({
+        //     tenant_id: profile.tenant_id,
+        //     credits: -uniqueNumbers.length,
+        //     transaction_type: 'IVR_UPLOAD',
+        //     description: `IVR Direct Broadcast Ingestion: ${uniqueNumbers.length.toLocaleString()} contacts split across ${K} campaign(s)`
+        // })
+        // if (ledgerError) console.error("Ledger deduction error:", ledgerError)
+
+        // 7. Save request record in ivr_upload_requests
+        const allocSummary = campaignAllocations.map(a => 
+            `${a.displayLabel}: ${a.uploadedCount.toLocaleString()} / ${a.allocatedCount.toLocaleString()} contacts${a.transactionId ? ` (Tx: ${a.transactionId})` : ''}`
+        ).join(' | ')
+
+        const allocationsMeta = campaignAllocations.map(a => ({
+            campaignName: a.campaignName,
+            campaignId: a.campaignId,
+            displayLabel: a.displayLabel,
+            allocatedCount: a.allocatedCount,
+            uploadedCount: a.uploadedCount,
+            transactionId: a.transactionId
+        }))
+
+        const combinedNotes = [
+            `[Direct Cloud Sync] ${allocSummary}`,
+            data.preferredSchedule ? `[Schedule: ${data.preferredSchedule}]` : '',
+            data.velocity ? `[Velocity: ${data.velocity}]` : '',
+            data.notes || ''
+        ].filter(Boolean).join(' ')
+
+        const initialNotes = formatIvrMeta(combinedNotes, null, 0, allocationsMeta)
+        const primaryDid = targetCampaigns[0]?.did ? String(targetCampaigns[0].did).replace(/^91/, '') : (data.didNumber || '')
+
+        const { error: insertError } = await supabaseAdmin.from('ivr_upload_requests').insert({
+            tenant_id: profile.tenant_id,
+            uploaded_by: user.id,
+            campaign_name: data.campaignName,
+            did_number: primaryDid,
+            total_contacts: uniqueNumbers.length,
+            notes: initialNotes,
+            status: 'uploaded'
+        })
+        if (insertError) console.error("ivr_upload_requests insert error:", insertError)
+
+        // 8. Generate Excel backup files and send email report in background
+        try {
+            const CHUNK_SIZE = 5000
+            const totalChunks = Math.ceil(uniqueNumbers.length / CHUNK_SIZE)
+            const attachments: Array<{ filename: string, content: string }> = []
+
+            const ExcelJSModule = await import('exceljs')
+            const ExcelJS = (ExcelJSModule as any).default || ExcelJSModule
+            const safeCampaignName = data.campaignName.replace(/[^a-zA-Z0-9_-]/g, '_')
+
+            for (let chunkIdx = 0; chunkIdx < totalChunks; chunkIdx++) {
+                const start = chunkIdx * CHUNK_SIZE
+                const end = Math.min(start + CHUNK_SIZE, uniqueNumbers.length)
+                const batch = uniqueNumbers.slice(start, end)
+
+                const workbook = new ExcelJS.Workbook()
+                const worksheet = workbook.addWorksheet('Contacts')
+                worksheet.getColumn(1).numFmt = '0'
+
+                for (const phone of batch) {
+                    worksheet.addRow([Number(phone)])
+                }
+
+                const buffer = await workbook.xlsx.writeBuffer()
+                const base64Content = Buffer.from(buffer).toString('base64')
+
+                const filename = totalChunks === 1
+                    ? `${safeCampaignName}_contacts.xlsx`
+                    : `${safeCampaignName}_part_${chunkIdx + 1}_of_${totalChunks}_contacts.xlsx`
+
+                attachments.push({ filename, content: base64Content })
+            }
+
+            const { Resend } = await import('resend')
+            const resend = new Resend(process.env.RESEND_API_KEY)
+            await resend.emails.send({
+                from: 'Hanva CRM <reports@crm.hanva.in>',
+                to: 'rajpootsingh260@gmail.com',
+                subject: `[Direct IVR Ingestion] ${org?.name || profile.tenant_id} - ${data.campaignName} - ${uniqueNumbers.length.toLocaleString()} contacts`,
+                html: `
+                    <h2>IVR Direct Campaign Ingestion Completed</h2>
+                    <p><b>Tenant:</b> ${org?.name || profile.tenant_id}</p>
+                    <p><b>Campaign Name:</b> ${data.campaignName}</p>
+                    <p><b>Total Contacts Ingested:</b> ${uniqueNumbers.length.toLocaleString()}</p>
+                    <p><b>Direct Campaign Line Allocations:</b></p>
+                    <ul>
+                        ${campaignAllocations.map(a => `<li><b>${a.displayLabel}</b> (${a.campaignName}): ${a.uploadedCount.toLocaleString()} contacts ingested ${a.transactionId ? `(Tx: ${a.transactionId})` : ''} - (Initial State: ${a.wasRunning ? 'RUNNING → Paused → Resumed' : 'READY → Started'})</li>`).join('')}
+                    </ul>
+                    <p><b>Notes:</b> ${data.notes || 'None'}</p>
+                `,
+                attachments
+            })
+        } catch (mailErr) {
+            console.warn("Background email notification error (non-blocking):", mailErr)
+        }
+
+        return {
+            success: true,
+            totalContacts: uniqueNumbers.length,
+            campaignAllocations: campaignAllocations.map(a => ({
+                campaignName: a.campaignName,
+                displayLabel: a.displayLabel,
+                uploadedCount: a.uploadedCount,
+                transactionId: a.transactionId
+            }))
+        }
+    } catch (e: any) {
+        console.error("Direct IVR Campaign Upload Error:", e)
+        return { success: false, error: e.message }
+    }
+}
