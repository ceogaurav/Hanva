+/**
+ * Fetches combined live dialer analytics across all allocated sub-campaigns for a specific broadcast.
+ * Aggregates Total Uploaded, Dialed, Connected, and Failed counts from Ozonetel during that broadcast's timeframe.
+ */
+export async function getBroadcastAggregatedAnalytics(requestId: string, isInternal: boolean = false) {
+    try {
+        if (!isInternal) {
+            try {
+                const supabase = await createClient()
+                const { data: { user } } = await supabase.auth.getUser()
+                if (!user) throw new Error("Unauthorized")
+            } catch (authErr: any) {
+                // If called outside request context without isInternal, rethrow unless internal fallback
+                if (!isInternal) throw authErr
+            }
+        }
+
+        const supabaseAdmin = getSupabaseAdmin()
+        const { data: req, error } = await supabaseAdmin
+            .from('ivr_upload_requests')
+            .select('*')
+            .eq('id', requestId)
+            .single()
+
+        if (error || !req) throw new Error("Broadcast record not found")
+
+        const meta = parseIvrMeta(req.notes)
+
+        // 1. Resolve Target Campaigns for this broadcast
+        let targetCampaignNames: string[] = []
+        let allocationMap: Record<string, { displayLabel?: string, allocatedCount: number, txId?: string }> = {}
+
+        // 1a. Check structured allocations if stored in meta
+        if (meta.allocations && meta.allocations.length > 0) {
+            for (const a of meta.allocations) {
+                targetCampaignNames.push(a.campaignName)
+                allocationMap[a.campaignName] = {
+                    displayLabel: a.displayLabel,
+                    allocatedCount: a.allocatedCount || 0,
+                    txId: a.transactionId
+                }
+            }
+        }
+
+        // 1b. Fallback: Parse notes for [Direct Cloud Sync] or [Direct Ozonetel Sync] labels
+        const hasSyncPart = meta.user_note.includes('[Direct Cloud Sync]') || meta.user_note.includes('[Direct Ozonetel Sync]')
+        if (targetCampaignNames.length === 0 && hasSyncPart) {
+            const syncPrefix = meta.user_note.includes('[Direct Cloud Sync]') ? '[Direct Cloud Sync]' : '[Direct Ozonetel Sync]'
+            const syncPart = meta.user_note.split(syncPrefix)[1]?.split('[')[0] || ''
+            const { campaigns: tCamps } = await getTenantOzonetelCampaigns(req.tenant_id, req.did_number ? [req.did_number] : [])
+            const matched: any[] = []
+            for (const c of tCamps || []) {
+                if (syncPart.includes(c.campaignName) || (c.did && syncPart.includes(c.did))) {
+                    matched.push(c)
+                }
+            }
+            const segs = syncPart.split('|')
+            for (const c of matched) {
+                targetCampaignNames.push(c.campaignName)
+                let parsedCount: number | null = null
+                let parsedTx: string | undefined = undefined
+                const cDid = c.did || ''
+                for (const seg of segs) {
+                    if ((cDid && seg.includes(cDid)) || seg.includes(c.campaignName)) {
+                        const countMatch = seg.match(/:\s*([\d,]+)\s*\/\s*([\d,]+)\s*contacts/i) || seg.match(/:\s*([\d,]+)/)
+                        if (countMatch) {
+                            parsedCount = parseInt(countMatch[1].replace(/,/g, ''), 10)
+                        }
+                        const txMatch = seg.match(/Tx:\s*(\d+)/i)
+                        if (txMatch) {
+                            parsedTx = txMatch[1]
+                        }
+                        break
+                    }
+                }
+
+                allocationMap[c.campaignName] = {
+                    displayLabel: c.displayLabel,
+                    allocatedCount: parsedCount || Math.round(req.total_contacts / Math.max(1, matched.length)),
+                    txId: parsedTx
+                }
+            }
+        }
+
+        // 1c. Fallback: Query all tenant outbound campaigns
+        if (targetCampaignNames.length === 0) {
+            const { campaigns: tCamps } = await getTenantOzonetelCampaigns(req.tenant_id, req.did_number ? [req.did_number] : [])
+            const activeCamps = (tCamps || []).filter((c: any) => c.position === 'RUNNING' || c.position === 'READY' || c.position === 'COMPLETED')
+            const list = activeCamps.length > 0 ? activeCamps : (tCamps || []).slice(0, 4)
+            for (const c of list) {
+                targetCampaignNames.push(c.campaignName)
+                allocationMap[c.campaignName] = {
+                    displayLabel: c.displayLabel,
+                    allocatedCount: Math.round(req.total_contacts / Math.max(1, list.length))
+                }
+            }
+        }
+
+        // 2. Determine timeframe for call aggregation
+        const cleanTenantId = (req.tenant_id || '').toLowerCase()
+        const createdAt = new Date(req.created_at)
+        const { data: nextReq } = await supabaseAdmin
+            .from('ivr_upload_requests')
+            .select('created_at')
+            .eq('tenant_id', req.tenant_id)
+            .gt('created_at', req.created_at)
+            .order('created_at', { ascending: true })
+            .limit(1)
+            .maybeSingle()
+
+        const fromTime = toOzonetelDateTime(createdAt)
+        const toTime = nextReq ? toOzonetelDateTime(nextReq.created_at) : toOzonetelDateTime(new Date(), true)
+
+        // 3. Fetch Ozonetel Campaign Productivity Report
+        let ozReports: OzonetelProductivityReportItem[] = []
+        try {
+            ozReports = await fetchCampaignProductivityReport(fromTime, toTime)
+        } catch (repErr) {
+            console.warn("fetchCampaignProductivityReport warning:", repErr)
+        }
+
+        // 4. Fetch live campaign positions from CloudAgent
+        let caCampaigns: any[] = []
+        try {
+            caCampaigns = await fetchCloudAgentOutboundCampaigns()
+        } catch (caErr) {
+            console.warn("fetchCloudAgentOutboundCampaigns warning:", caErr)
+        }
+
+        // 5. Fetch exact leads converted in CRM during this broadcast window
+        let leadsQuery = supabaseAdmin
+            .from('leads')
+            .select('id, name, phone, notes, created_at')
+            .eq('tenant_id', req.tenant_id)
+            .gte('created_at', req.created_at)
+            .or('name.ilike.%IVR%,notes.ilike.%IVR%')
+
+        if (nextReq) {
+            leadsQuery = leadsQuery.lt('created_at', nextReq.created_at)
+        }
+        const { data: convertedLeadRows } = await leadsQuery
+        const convertedLeads = Array.isArray(convertedLeadRows) ? convertedLeadRows.length : (meta.leads_count || 0)
+
+        // 6. Aggregate metrics across all allocated sub-campaigns (using live call stats fallback if batch reports are pending)
+        const subCampaigns = await Promise.all(targetCampaignNames.map(async (cName) => {
+            const rep = ozReports.find(r => r.campaignName === cName)
+            const alloc = allocationMap[cName]
+            const live = caCampaigns.find(c => c.campaignName === cName || (c.did && alloc?.displayLabel?.includes(c.did)))
+
+            let dialed = rep ? parseInt(rep.totalCalls, 10) || 0 : 0
+            let connected = rep ? parseInt(rep.totalConnectedCalls, 10) || 0 : 0
+            let failed = rep ? parseInt(rep.totalAbandonedCalls, 10) || 0 : 0
+            let rate = dialed > 0 ? ((connected / dialed) * 100).toFixed(1) + '%' : '0.0%'
+            let avgTalkTime = rep?.avgCallTalkTime || '--'
+
+            // If Ozonetel hourly batch report is empty (calls happening live today), query liveReportApi apiId 1045
+            if (dialed === 0 && live?.campaignId) {
+                try {
+                    const liveStats = await fetchCloudAgentLiveCampaignStats(
+                        live.campaignId,
+                        fromTime,
+                        toTime,
+                        50000
+                    )
+                    if (liveStats.dialed > 0) {
+                        dialed = liveStats.dialed
+                        connected = liveStats.connected
+                        failed = liveStats.failed
+                        rate = liveStats.connectionRate
+                        avgTalkTime = liveStats.avgTalkTime
+                    }
+                } catch (liveErr) {
+                    console.warn(`fetchCloudAgentLiveCampaignStats failed for ${cName}:`, liveErr)
+                }
+            }
+
+            // Count leads attributed specifically to this campaign
+            const campaignLeadsCount = (convertedLeadRows || []).filter((l: any) => {
+                const note = l.notes || ''
+                return note.includes(cName) || (alloc?.displayLabel && note.includes(alloc.displayLabel))
+            }).length
+
+            return {
+                campaignName: cName,
+                displayLabel: alloc?.displayLabel || cName
+                    .replace(new RegExp('_?' + cleanTenantId, 'i'), '')
+                    .replace(/_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i, '')
+                    .replace(/^IVRBlast_?/i, '')
+                    .trim() || cName,
+                allocatedCount: alloc?.allocatedCount || 0,
+                dialed,
+                connected,
+                failed,
+                connectionRate: rate,
+                convertedLeads: campaignLeadsCount,
+                avgTalkTime,
+                avgPickupTime: rep?.avgCallPickupTime || '--',
+                position: live?.position || 'READY',
+                transactionId: alloc?.txId
+            }
+        }))
+
+        let totalDialed = 0
+        let totalConnected = 0
+        let totalFailed = 0
+
+        for (const sub of subCampaigns) {
+            totalDialed += sub.dialed
+            totalConnected += sub.connected
+            totalFailed += sub.failed
+        }
+
+        const overallConnectionRate = totalDialed > 0 ? ((totalConnected / totalDialed) * 100).toFixed(1) + '%' : '0.0%'
+        const overallConversionRate = totalConnected > 0 ? ((convertedLeads / totalConnected) * 100).toFixed(1) + '%' : '0.0%'
+
+        return {
+            success: true,
+            broadcast: {
+                id: req.id,
+                campaignName: req.campaign_name,
+                didNumber: req.did_number,
+                totalContacts: req.total_contacts,
+                createdAt: req.created_at,
+                status: req.status
+            },
+            timeframe: {
+                fromTime,
+                toTime
+            },
+            totals: {
+                totalContacts: req.total_contacts,
+                totalDialed,
+                totalConnected,
+                callStartCount: totalConnected, // 1:1 match: connected calls == CALL_START checkpoint count
+                totalFailed,
+                connectionRate: overallConnectionRate,
+                convertedLeads,
+                conversionRate: overallConversionRate,
+                pendingToDial: Math.max(0, req.total_contacts - totalDialed)
+            },
+            subCampaigns
+        }
+    } catch (e: any) {
+        console.error("getBroadcastAggregatedAnalytics error:", e)
+        return { success: false, error: e.message }
+    }
+}
