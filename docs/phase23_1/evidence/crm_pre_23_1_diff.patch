+/**
+ * Start or Stop an Ozonetel Campaign (both CloudAgent Portal and CCaaS API)
+ */
+export async function toggleOzonetelCampaignStatus(
+    campaignName: string, 
+    action: 'Start' | 'Stop',
+    campaignId?: number
+) {
+    try {
+        let cId = campaignId
+        if (!cId) {
+            try {
+                const allCamps = await fetchCloudAgentOutboundCampaigns()
+                const found = allCamps.find(c => c.campaignName === campaignName)
+                if (found) cId = found.campaignId
+            } catch (err) {
+                console.warn("Could not resolve numeric campaignId:", err)
+            }
+        }
+
+        const promises: Promise<any>[] = [
+            setOzonetelCampaignStatus(campaignName, action)
+        ]
+
+        if (cId) {
+            promises.push(
+                setCloudAgentCampaignPosition(cId, action === 'Start' ? 'start' : 'stop')
+            )
+        }
+
+        const results = await Promise.allSettled(promises)
+        const ccaasRes = results[0]?.status === 'fulfilled' ? results[0].value : null
+        const caRes = results[1]?.status === 'fulfilled' ? results[1].value : null
+
+        const success = Boolean((ccaasRes && ccaasRes.success) || (caRes && caRes.success))
+
+        return {
+            success,
+            campaignName,
+            campaignId: cId,
+            action,
+            isRunning: action === 'Start',
+            message: caRes?.message || ccaasRes?.message || (action === 'Start' ? 'Campaign started' : 'Campaign stopped')
+        }
+    } catch (error: any) {
+        console.error('toggleOzonetelCampaignStatus error:', error)
+        return { success: false, campaignName, action, error: error.message }
+    }
+}
