+/**
+ * Fetch campaign status from Ozonetel
+ */
+export async function getOzonetelCampaignStatus(campaignName: string) {
+    try {
+        const userName = process.env.OZONETEL_USER_NAME || '[REDACTED]'
+        const data = await ozonetelRequest(
+            'https://in1-ccaas-api.ozonetel.com/ca_apis/campaignStatus',
+            'GET',
+            { userName, campaignName }
+        )
+
+        if (data?.status === 'success' && Array.isArray(data?.message) && data.message.length > 0) {
+            const pos = data.message[0].Position
+            return {
+                success: true,
+                campaignName,
+                campaignId: data.message[0].CampaignID,
+                position: pos as 'RUNNING' | 'READY',
+                isRunning: pos === 'RUNNING'
+            }
+        }
+
+        if (data?.message === 'no record found' || data?.status === 'failure') {
+            return {
+                success: false,
+                campaignName,
+                position: 'NOT_FOUND' as const,
+                isRunning: false,
+                message: data.message || 'Campaign not found'
+            }
+        }
+
+        return {
+            success: false,
+            campaignName,
+            position: 'UNKNOWN' as const,
+            isRunning: false,
+            raw: data
+        }
+    } catch (error: any) {
+        console.error('getOzonetelCampaignStatus error:', error)
+        return { success: false, campaignName, position: 'ERROR' as const, error: error.message }
+    }
+}
