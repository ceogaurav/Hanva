+/**
+ * Effective cut-off timestamp for new CALL_START checkpoint credit consumption rule.
+ * As instructed: do NOT change today's existing credit consumption.
+ * Any upload request created strictly AFTER this cut-off time will calculate and deduct
+ * credits based on the new CALL_START checkpoint count rule.
+ */
+const CALL_START_RULE_EFFECTIVE_TIME = new Date('2026-11-16T12:15:00.000Z') // 17:45 IST, 16 Nov 2026
+
+/**
+ * Effective cut-off timestamp for new 1.55 credits per connected call rate.
+ * Any campaign created strictly ON or AFTER 24 Nov 2026 11:15 IST (2026-11-24T05:45:00.000Z)
+ * will be charged at 1.55 credits per connected call.
+ * Previous campaigns retain their earlier rate (1.38 credits).
+ */
+const RATE_1_55_EFFECTIVE_TIME = new Date('2026-11-24T05:45:00.000Z') // 11:15 IST, 24 Nov 2026
+
+/**
+ * Automatically settles credit consumption for an IVR broadcast upon completion.
+ * Rate: 1.55 credits per connected call (CALL_START checkpoint) for campaigns created on/after 24 Nov 2026.
+ * (Legacy campaigns retain original 1.38 rate).
+ * Deducts credits and logs in wallet_ledger with transaction_type: 'IVR_CAMPAIGN_CONSUMPTION'.
+ * Idempotent: checks wallet_ledger reference_id before deducting to prevent duplicate billing.
+ * Note: Formula / multiplier calculation details are strictly not disclosed in description or frontend.
+ */
+export async function settleIvrCampaignCredits(uploadRequestId: string): Promise<{
+    success: boolean
+    settled: boolean
+    connectedCalls?: number
+    callStartCount?: number
+    creditsDeducted?: number
+    error?: string
+}> {
+    try {
+        if (!uploadRequestId) return { success: false, settled: false, error: 'Request ID required' }
+        const supabaseAdmin = getSupabaseAdmin()
+
+        // 1. Fetch request info
+        const { data: req, error: reqErr } = await supabaseAdmin
+            .from('ivr_upload_requests')
+            .select('id, tenant_id, campaign_name, created_at, status')
+            .eq('id', uploadRequestId)
+            .single()
+
+        if (reqErr || !req) return { success: false, settled: false, error: reqErr?.message || 'Request not found' }
+
+        // 2. Idempotency Check: Check if already settled in wallet_ledger
+        const { data: existingLedger } = await supabaseAdmin
+            .from('wallet_ledger')
+            .select('id, credits')
+            .eq('reference_id', uploadRequestId)
+            .eq('transaction_type', 'IVR_CAMPAIGN_CONSUMPTION')
+            .maybeSingle()
+
+        if (existingLedger) {
+            return {
+                success: true,
+                settled: true,
+                creditsDeducted: Math.abs(Number(existingLedger.credits || 0)),
+                error: 'Already settled'
+            }
+        }
+
+        // 3. Compute connected calls using getBroadcastAggregatedAnalytics (internal = true to bypass cookies)
+        const analytics = await getBroadcastAggregatedAnalytics(uploadRequestId, true)
+        if (!analytics.success || !analytics.totals) {
+            return { success: false, settled: false, error: analytics.error || 'Failed to fetch broadcast analytics' }
+        }
+
+        const reqCreatedAt = new Date(req.created_at)
+        const isNewCallStartRule = reqCreatedAt >= CALL_START_RULE_EFFECTIVE_TIME
+        const isRate155 = reqCreatedAt >= RATE_1_55_EFFECTIVE_TIME
+        const ratePerConnectedCall = isRate155 ? 1.55 : 1.38
+
+        // Connected calls represent the exact CALL_START checkpoint count in Ozonetel
+        const callStartCount = analytics.totals.totalConnected || 0
+        if (callStartCount <= 0) {
+            console.log(`[IVR Settlement] Request ${req.id} (${req.campaign_name}): 0 CALL_START / connected calls detected. Skipping deduction.`)
+            return { success: true, settled: false, connectedCalls: 0, callStartCount: 0, creditsDeducted: 0 }
+        }
+
+        // 4. Rate: every CALL_START connected call * ratePerConnectedCall (rounded)
+        const creditsToDeduct = Math.round(callStartCount * ratePerConnectedCall)
+
+        // 5. Insert ledger deduction (database trigger automatically debits tenant_wallets)
+        const { error: ledgerError } = await supabaseAdmin.from('wallet_ledger').insert({
+            tenant_id: req.tenant_id,
+            credits: -creditsToDeduct,
+            transaction_type: 'IVR_CAMPAIGN_CONSUMPTION',
+            description: `IVR Campaign: ${req.campaign_name || 'Broadcast'}`,
+            reference_id: req.id
+        })
+
+        if (ledgerError) throw ledgerError
+
+        console.log(`🪙 [IVR Settlement ${isRate155 ? 'RATE 1.55' : isNewCallStartRule ? 'NEW CALL_START RULE' : 'LEGACY'}] Settled campaign ${req.id} (${req.campaign_name}): ${callStartCount} CALL_START calls @ ${ratePerConnectedCall}/call -> Deducted ${creditsToDeduct} credits`)
+
+        // Check if balance is now negative, and trigger automated WhatsApp reminder (Option 2 with 24h anti-spam rate limiting)
+        try {
+            const { data: updatedWallet } = await supabaseAdmin
+                .from('tenant_wallets')
+                .select('credits_balance')
+                .eq('tenant_id', req.tenant_id)
+                .maybeSingle()
+
+            if (updatedWallet && updatedWallet.credits_balance < 0) {
+                const { sendTenantLowBalanceAlert } = await import('@/app/actions/whatsapp-billing-alerts')
+                sendTenantLowBalanceAlert(req.tenant_id).catch((alertErr) => {
+                    console.warn(`[IVR Settlement] WhatsApp low balance alert deferred error:`, alertErr)
+                })
+            }
+        } catch (e) {
+            console.warn(`[IVR Settlement] Balance alert check error:`, e)
+        }
+
+        return {
+            success: true,
+            settled: true,
+            connectedCalls: callStartCount,
+            callStartCount,
+            creditsDeducted: creditsToDeduct
+        }
+    } catch (err: any) {
+        console.error("settleIvrCampaignCredits error:", err)
+        return { success: false, settled: false, error: err.message }
+    }
+}
