+/**
+ * Fetch all available campaigns from Ozonetel and filter by tenant ID (and optional DIDs)
+ */
+export async function getTenantOzonetelCampaigns(tenantId?: string, didNumbers: string[] = []) {
+    try {
+        let tId = tenantId
+        if (!tId) {
+            const supabase = await createClient()
+            const { data: { user } } = await supabase.auth.getUser()
+            if (!user) throw new Error("Unauthorized")
+            const { data: profile } = await supabase.from('users').select('tenant_id').eq('id', user.id).single()
+            tId = profile?.tenant_id
+        }
+        if (!tId) return { success: false, campaigns: [], error: 'Tenant ID required' }
+
+        const cleanTenantId = (tId || '').toLowerCase().trim()
+        const cleanDids = (didNumbers || []).map(d => String(d).replace(/\D/g, '').slice(-10)).filter(Boolean)
+
+        // Primary: Query CloudAgent directly to get exact numeric campaignId and real-time position
+        let caCampaigns: any[] = []
+        try {
+            caCampaigns = await fetchCloudAgentOutboundCampaigns()
+        } catch (caErr) {
+            console.warn("fetchCloudAgentOutboundCampaigns warning:", caErr)
+        }
+
+        let matched: any[] = []
+        if (caCampaigns.length > 0) {
+            matched = caCampaigns.filter(c => {
+                if (c.campaignType === 'InBound') return false
+                const camp = (c.campaignName || '').toLowerCase()
+                if (cleanTenantId) {
+                    return camp.includes(cleanTenantId)
+                }
+                for (const did of cleanDids) {
+                    if (did && (camp.includes(did) || (c.did && String(c.did).includes(did)))) return true
+                }
+                return false
+            })
+        }
+
+        // Fallback to CCaaS getAvailableCampaigns if CloudAgent returned no matches
+        if (matched.length === 0) {
+            const userName = process.env.OZONETEL_USER_NAME || '[REDACTED]'
+            const data = await ozonetelRequest(
+                'https://in1-ccaas-api.ozonetel.com/ca_apis/getAvailableCampaigns',
+                'GET',
+                { userName }
+            )
+            const all = Array.isArray(data?.message) ? data.message : []
+            matched = all.filter((c: any) => {
+                if (c.CampaignType === 'InBound') return false
+                const camp = (c.Campaign || '').toLowerCase()
+                if (cleanTenantId) {
+                    return camp.includes(cleanTenantId)
+                }
+                for (const did of cleanDids) {
+                    if (did && (camp.includes(did) || (c.DID && String(c.DID).includes(did)))) return true
+                }
+                return false
+            }).map((c: any) => ({
+                campaignId: Number(c.CampaignID || 0),
+                campaignName: c.Campaign,
+                did: c.DID ? String(c.DID).replace(/^91/, '') : '',
+                campaignType: c.CampaignType,
+                position: c.Position
+            }))
+        }
+
+        // Sort: RUNNING first (1), READY (2), COMPLETED (3), PAUSED (4), STOPPED (5). 
+        // Secondary sort by CampaignID descending (newest campaigns first).
+        const statusWeight: Record<string, number> = { RUNNING: 1, READY: 2, COMPLETED: 3, PAUSED: 4, STOPPED: 5 }
+        matched.sort((a: any, b: any) => {
+            const wa = statusWeight[a.position] || 9
+            const wb = statusWeight[b.position] || 9
+            if (wa !== wb) return wa - wb
+            return (b.campaignId || 0) - (a.campaignId || 0)
+        })
+
+        const campaigns = matched.map((c: any) => {
+            let label = c.campaignName
+                .replace(new RegExp('_?' + cleanTenantId, 'i'), '')
+                .replace(/_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i, '')
+                .replace(/^IVRBlast_?/i, '')
+                .trim()
+            if (c.did) {
+                const displayDid = String(c.did).replace(/^91/, '')
+                if (!label.includes(displayDid)) {
+                    label = label ? `${label} (${displayDid})` : `Line ${displayDid}`
+                }
+            }
+            if (!label) label = c.campaignName
+            return {
+                campaignName: c.campaignName,
+                campaignId: c.campaignId,
+                position: c.position as string,
+                did: c.did ? String(c.did).replace(/^91/, '') : '',
+                type: c.campaignType,
+                displayLabel: label,
+                ivrFlow: c.ivrFlow || ''
+            }
+        })
+
+        // Lazily sync real campaign DIDs into tenant_did_registry so all modules reflect the actual live numbers
+        if (tId && campaigns.length > 0) {
+            try {
+                const supabaseAdmin = getSupabaseAdmin()
+                const { data: existingDids } = await supabaseAdmin
+                    .from('tenant_did_registry')
+                    .select('id, did_number, is_active')
+                    .eq('tenant_id', tId)
+
+                const activeCampaignDids = new Set(
+                    campaigns.map((c: any) => c.did ? String(c.did).replace(/\D/g, '').slice(-10) : '').filter(Boolean)
+                )
+
+                // Deactivate any registered DIDs that don't belong to any live tenant campaign
+                for (const reg of existingDids || []) {
+                    const cleanRegDid = String(reg.did_number).replace(/\D/g, '').slice(-10)
+                    if (!activeCampaignDids.has(cleanRegDid) && reg.is_active) {
+                        await supabaseAdmin.from('tenant_did_registry').update({ is_active: false }).eq('id', reg.id)
+                    }
+                }
+
+                // Ensure all live campaign DIDs exist and are active
+                const existingMap = new Map((existingDids || []).map((d: any) => [String(d.did_number).replace(/\D/g, '').slice(-10), d]))
+                for (const camp of campaigns) {
+                    const clean = camp.did ? String(camp.did).replace(/\D/g, '').slice(-10) : ''
+                    if (!clean) continue
+                    const cleanLabel = (camp.displayLabel || camp.campaignName)
+                        .replace(/\s*\(\d+\)$/, '')
+                        .replace(/^IVRBlast_?/i, '')
+                        .replace(new RegExp('_?' + cleanTenantId, 'i'), '')
+                        .trim()
+
+                    const existing = existingMap.get(clean)
+                    if (existing) {
+                        if (!existing.is_active) {
+                            await supabaseAdmin.from('tenant_did_registry').update({ is_active: true, label: cleanLabel || existing.label }).eq('id', existing.id)
+                        }
+                    } else {
+                        await supabaseAdmin.from('tenant_did_registry').insert({
+                            tenant_id: tId,
+                            did_number: clean,
+                            label: cleanLabel || 'Campaign Line',
+                            is_active: true
+                        })
+                    }
+                }
+            } catch (syncErr) {
+                console.warn("Error syncing campaign DIDs to tenant_did_registry:", syncErr)
+            }
+        }
+
+        return { success: true, count: campaigns.length, campaigns }
+    } catch (error: any) {
+        console.error('getTenantOzonetelCampaigns error:', error)
+        return { success: false, campaigns: [], error: error.message }
+    }
+}
