+// --- IN-MEMORY CACHES (5-MINUTE TTL) TO DRASTICALLY REDUCE SUPABASE LOG INGESTION & REST QUERIES ---
+const CACHE_TTL_MS = 5 * 60 * 1000;
+let didCacheMap: Map<string, string> | null = null;
+let didCacheExpiresAt = 0;
+
+async function getCachedDidMap(supabaseAdmin: any): Promise<Map<string, string>> {
+  const now = Date.now();
+  if (didCacheMap && now < didCacheExpiresAt) {
+    return didCacheMap;
+  }
+  const { data } = await supabaseAdmin
+    .from('tenant_did_registry')
+    .select('tenant_id, did_number')
+    .eq('is_active', true);
+
+  const nextMap = new Map<string, string>();
+  for (const row of data || []) {
+    if (row.did_number && row.tenant_id) {
+      const clean = String(row.did_number).replace(/\D/g, '').slice(-10);
+      if (clean.length === 10) nextMap.set(clean, row.tenant_id);
+      nextMap.set(String(row.did_number), row.tenant_id);
+    }
+  }
+  didCacheMap = nextMap;
+  didCacheExpiresAt = now + CACHE_TTL_MS;
+  return nextMap;
+}
+
+const orgTriggersCache = new Map<string, { triggers: any; expiresAt: number }>();
+
+async function getCachedOrgTriggers(supabaseAdmin: any, tenantId: string): Promise<any> {
+  const now = Date.now();
+  const cached = orgTriggersCache.get(tenantId);
+  if (cached && now < cached.expiresAt) {
+    return cached.triggers;
+  }
+  const { data: orgData } = await supabaseAdmin
+    .from('organizations')
+    .select('workflow_triggers')
+    .eq('id', tenantId)
+    .maybeSingle();
+
+  const triggers = orgData?.workflow_triggers || {};
+  orgTriggersCache.set(tenantId, { triggers, expiresAt: now + CACHE_TTL_MS });
+  return triggers;
+}
+
+// --- IST TIMEZONE HELPER ---
+function getStartOfTodayIST() {
+  const now = new Date();
+  const istOffset = 5.5 * 60 * 60 * 1000;
+  const nowIST = new Date(now.getTime() + istOffset);
+  nowIST.setUTCHours(0, 0, 0, 0); 
+  return new Date(nowIST.getTime() - istOffset).toISOString();
+}
+
+// --- FAIR DISTRIBUTION HELPER FUNCTION (LEAST LEADS TODAY AMONG CHECKED-IN TELECALLERS) ---
+async function getFairAssigneeId(supabaseAdmin: any, tenantId: string): Promise<string | null> {
+  try {
+    const startOfTodayISO = getStartOfTodayIST();
+
+    // 1. Fetch checked-in users today (check_out is null)
+    const { data: attendanceData } = await supabaseAdmin
+        .from("attendance")
+        .select("user_id")
+        .eq("tenant_id", tenantId)
+        .is("check_out", null)
+        .gte("check_in", startOfTodayISO);
+
+    let checkedInUserIds = Array.from(new Set(attendanceData?.map((a: any) => a.user_id) || []));
+
+    // Fallback: Check last 14 hours if no check-in since midnight IST
+    if (checkedInUserIds.length === 0) {
+        const maxShiftStart = new Date(Date.now() - 14 * 60 * 60 * 1000).toISOString();
+        const { data: recentAttendance } = await supabaseAdmin
+            .from("attendance")
+            .select("user_id")
+            .eq("tenant_id", tenantId)
+            .gte("check_in", maxShiftStart)
+            .is("check_out", null);
+        checkedInUserIds = Array.from(new Set(recentAttendance?.map((a: any) => a.user_id) || []));
+    }
+
+    if (checkedInUserIds.length === 0) {
+        console.warn(`[Ozonetel Webhook] No checked-in agents found for tenant ${tenantId}.`);
+        return null;
+    }
+
+    // 2. Fetch telecaller/agent users who are checked in and available
+    // Note: Attendance check-in is the source of truth for shift presence; ignore stale 'offline' flags
+    // and only exclude explicitly deactivated users or agents currently on 'break'.
+    const { data: telecallers } = await supabaseAdmin
+        .from("users")
+        .select("id, full_name, role, current_status, is_active")
+        .eq("tenant_id", tenantId)
+        .in("role", ["telecaller", "agent", "user"]);
+
+    const activeTelecallers = (telecallers || []).filter((t: any) => 
+        checkedInUserIds.includes(t.id) && t.is_active !== false && t.current_status !== 'break'
+    );
+
+    if (activeTelecallers.length === 0) {
+        console.warn(`[Ozonetel Webhook] Checked-in users exist, but none currently available as active telecallers.`);
+        return null;
+    }
+
+    // 3. Count leads assigned today to each eligible telecaller
+    const { data: todaysLeads } = await supabaseAdmin
+        .from("leads")
+        .select("assigned_to")
+        .eq("tenant_id", tenantId)
+        .gte("created_at", startOfTodayISO);
+
+    const leadCounts: Record<string, number> = {};
+    activeTelecallers.forEach((t: any) => { leadCounts[t.id] = 0; });
+
+    if (todaysLeads) {
+        todaysLeads.forEach((l: any) => {
+            if (l.assigned_to && leadCounts[l.assigned_to] !== undefined) {
+                leadCounts[l.assigned_to]++;
+            }
+        });
+    }
+
+    // 4. Select the telecaller with minimum lead count (random among ties)
+    const minLeads = Math.min(...Object.values(leadCounts));
+    const eligibleTelecallers = activeTelecallers.filter((t: any) => leadCounts[t.id] === minLeads);
+    const winner = eligibleTelecallers[Math.floor(Math.random() * eligibleTelecallers.length)];
+
+    console.warn(`[Ozonetel Webhook] Fair distribution selected agent ${winner.id} (${winner.full_name}) with today's lead count: ${minLeads}`);
+    return winner.id;
+  } catch (err) {
+    console.error("[Ozonetel Webhook] Error in getFairAssigneeId:", err);
+    return null;
+  }
+}
