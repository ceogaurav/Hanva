+
+        const { data: profile } = await supabase
+            .from('users')
+            .select('role')
+            .eq('id', user.id)
+            .single()
+
+        if (profile?.role !== 'super_admin') {
+            return { success: false, message: "Access Denied: Only Super Admins can manually force-complete campaigns." }
+        }
+
+        const res = await forceCompleteCloudAgentCampaign(campaignId)
+        return res
+    } catch (error: any) {
+        console.error('forceCompleteOzonetelCampaign error:', error)
+        return { success: false, message: error.message || "Failed to force complete campaign" }
+    }
+}
