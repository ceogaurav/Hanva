# HANVA CRM — HARDENED .env.example (Placeholders Only — Zero Real Secrets)

# Core Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Application URL
NEXT_PUBLIC_APP_URL=https://crm.hanva.in

# Internal Cron & Background Security (minimum 32-byte random hex; NEVER reuse defaults)
CRON_SECRET=replace_with_32byte_hex_cron_secret

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
NEXT_PUBLIC_IVR_CREDIT_PRICE=0.20

# Upstash QStash (Fonada Async Worker Queue Signature Keys — Required in Production)
QSTASH_TOKEN=replace_with_qstash_token
QSTASH_CURRENT_SIGNING_KEY=replace_with_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=replace_with_qstash_next_signing_key

# Upstash Redis (Distributed Multi-Instance Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_redis_token

# Telephony & WhatsApp Integrations (Server-Only)
CLOUDCONNECT_WEBHOOK_SECRET=replace_with_cloudconnect_hmac_or_token
CLOUDCONNECT_API_TOKEN=replace_with_cloudconnect_api_token
OZONETEL_API_KEY=replace_with_ozonetel_api_key
OZONETEL_USER_NAME=replace_with_ozonetel_username
OZONETEL_PORTAL_USER=replace_with_ozonetel_portal_user
OZONETEL_PORTAL_PASS=replace_with_ozonetel_portal_password
FONADA_WHATSAPP_BEARER_TOKEN=replace_with_fonada_bearer_token
FONADA_WHATSAPP_ACCOUNT_ID=replace_with_fonada_account_uuid
FONADA_WABA_NUMBER=replace_with_waba_msisdn
FONADA_USERID=replace_with_fonada_userid
FONADA_PASSWORD=replace_with_fonada_password
WHATSAPP_VERIFY_TOKEN=replace_with_whatsapp_verify_token
WHATSAPP_APP_SECRET=replace_with_meta_or_provider_hmac_secret

# Email / AI / Search / Push Services
RESEND_API_KEY=replace_with_resend_api_key
OPENROUTER_API_KEY=replace_with_openrouter_api_key
CALENDARIFIC_API_KEY=replace_with_server_only_calendarific_key
COMPANY_ELIGIBILITY_API_URL=http://127.0.0.1:8080
MEILISEARCH_MASTER_KEY=replace_with_meilisearch_master_key
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=replace_with_meilisearch_read_only_search_key
NEXT_PUBLIC_MEILISEARCH_HOST=https://search.example.com
VAPID_SUBJECT=mailto:support@hanva.in
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key

# Website Signed Ingestion Gateway (Disabled until Stage A/Phase 23.1 sign-off)
WEBSITE_LEAD_INGEST_BEARER=replace_with_32byte_website_ingest_token
WEBSITE_LEAD_HMAC_SECRET=replace_with_32byte_website_hmac_secret
HANVA_INTERNAL_TENANT_ID=replace_with_verified_hanva_org_uuid
